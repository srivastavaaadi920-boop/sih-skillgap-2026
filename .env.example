# Database
DATABASE_URL="postgresql://username:password@localhost:5432/academia_portal?schema=public"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-secret-key-here-change-in-production"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mock Mode - Set to "true" to bypass database (for testing)
MOCK_MODE="false"

# Anthropic API Key (for AI-generated test questions)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="your-api-key-here"
